{
  "individualUsersMetrics": {
    "chartName": "DSS_HEALTH_COMPLAINTS_BY_HEALTH_DISTRICT_TOTAL_BURUNDI",
    "queries": [
      {
        "module": "COMMON",
        "dateRefField": "Data.createdTime",
        "requestQueryMap": "{\"cycle\": \"Data.additionalDetails.cycleIndex.keyword\", \"userId\": \"Data.syncedUserId.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "os-user-sync-index-v1",
        "transformData": "linearAggregation",
        "transformKey": "lastSyncTimeTransformer",
        "aggrQuery": "{\"size\":0,\"aggs\":{\"LastSyncTime\":{\"max\":{\"field\":\"Data.syncedTimeStamp\"}}}}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.syncedTime",
        "requestQueryMap": "{\"cycle\": \"Data.additionalDetails.cycleIndex.keyword\", \"userId\": \"Data.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "os-project-task-index-v1",
        "transformData": "linearAggregation",
        "transformKey": "taskRecordCountTransformer",
        "aggrQuery": "{\"size\":0,\"aggs\":{\"Task Records\":{\"value_count\":{\"field\":\"Data.id.keyword\"}}}}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.syncedTime",
        "requestQueryMap": "{\"cycle\": \"Data.additionalDetails.cycleIndex.keyword\", \"userId\": \"Data.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "os-stock-index-v1",
        "transformData": "linearAggregation",
        "transformKey": "stockRecordCountTransformer",
        "aggrQuery": "{\"size\":0,\"aggs\":{\"Stock Records\":{\"value_count\":{\"field\":\"Data.id.keyword\"}}}}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.syncedTime",
        "requestQueryMap": "{\"cycle\": \"Data.additionalDetails.cycleIndex.keyword\", \"userId\": \"Data.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "os-project-task-index-v1",
        "transformData": "linearAggregation",
        "transformKey": "latestGpsTransformer",
        "aggrQuery": "{\"size\":0,\"aggs\":{\"LatestDoc\":{\"top_hits\":{\"size\":1,\"sort\":[{\"Data.syncedTimeStamp\":{\"order\":\"desc\"}}],\"_source\":{\"includes\":[\"Data.geoPoint\",\"Data.syncedTimeStamp\"]}}}}}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.auditDetails.createdTime",
        "requestQueryMap": "{\"userId\": \"Data.auditDetails.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "os-transformed-errors-index-v1",
        "transformData": "linearAggregation",
        "transformKey": "failedRecordCountTransformer",
        "aggrQuery": "{\"size\":0,\"aggs\":{\"Error Records\":{\"value_count\":{\"field\":\"Data.id.keyword\"}}}}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.service.auditDetails.createdTime",
        "requestQueryMap": "{\"userId\": \"Data.service.auditDetails.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "os-transformer-pgr-services",
        "transformData": "linearAggregation",
        "transformKey": "complaintsRecordCountTransformer",
        "aggrQuery": "{\"size\":0,\"aggs\":{\"Complaint Records\":{\"value_count\":{\"field\":\"Data.service.serviceRequestId.keyword\"}}}}"
      }
    ],
    "chartType": "rawResponse",
    "transform": {
      "failedRecordCountTransformer": {
        "transformationMappings": [
          {
            "failedRecordCount": "Error Records.value"
          }
        ]
      },
      "taskRecordCountTransformer": {
        "transformationMappings": [
          {
            "taskRecordCount": "Task Records.value"
          }
        ]
      },
      "complaintsRecordCountTransformer": {
        "transformationMappings": [
          {
            "complaintRecordCount": "Complaint Records.value"
          }
        ]
      },
      "stockRecordCountTransformer": {
        "transformationMappings": [
          {
            "stockRecordCount": "Stock Records.value"
          }
        ]
      },
      "latestGpsTransformer": {
        "transformationMappings": [
          {
            "latestGps": "LatestDoc.hits.hits[0]._source.Data.geoPoint"
          }
        ]
      },
      "lastSyncTimeTransformer": {
        "transformationMappings": [
          {
            "lastSyncTime": "LastSyncTime.value_as_string"
          }
        ]
      }
    },
    "merges": [
      {
        "mergeType": "linear",
        "mergeKey": "combinedUserStats",
        "flatten": true,
        "datasets": [],
        "outputMappings": [
          {
            "totalRecordsCount": "add(complaintRecordCount, add(taskRecordCount, stockRecordCount))"
          }
        ]
      }
    ],
    "isCumulative": false,
    "valueType": "number",
    "showLabel": true,
    "drillChart": "none",
    "filterKeys": [
      {
        "key": "Users"
      }
    ],
    "documentType": "_doc",
    "action": "",
    "aggregationPaths": [
      "totalRecordsCount",
      "latestGps",
      "failedRecordCount",
      "lastSyncTime"
    ],
    "insight": {},
    "_comment": " "
  },
  "usersRecordsSummaryTable": {
    "chartName": "DSS_HEALTH_COMPLAINTS_BY_HEALTH_DISTRICT_TOTAL_BURUNDI",
    "queries": [
      {
        "module": "COMMON",
        "dateRefField": "Data.syncedTime",
        "requestQueryMap": "{\"cycle\": \"Data.additionalDetails.cycleIndex.keyword\", \"userId\": \"Data.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "os-project-task-index-v1",
        "transformData": "rawDocuments",
        "transformKey": "taskTransformer",
        "aggrQuery": "{\"size\":10000,\"query\":{\"bool\":{\"must\":[],\"must_not\":[]}},\"_source\":[\"Data.geoPoint\",\"Data.taskId\",\"Data.productName\",\"Data.administrationStatus\",\"Data.@timestamp\",\"Data.quantity\",\"Data.latitude\",\"Data.longitude\",\"Data.boundaryHierarchy.subHills\",\"Data.additionalDetails.cycleIndex.keyword\"]}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.syncedTime",
        "requestQueryMap": "{\"cycle\": \"Data.additionalDetails.cycleIndex.keyword\", \"userId\": \"Data.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "os-stock-index-v1",
        "transformData": "rawDocuments",
        "transformKey": "stockTransformer",
        "aggrQuery": "{\"size\":100,\"query\":{\"bool\":{\"must\":[]}},\"_source\":[\"Data.id\",\"Data.productName\",\"Data.eventType\",\"Data.reason\",\"Data.facilityName\",\"Data.transactingFacilityName\",\"Data.@timestamp\",\"Data.physicalCount\",\"Data.additionalDetails.lat\",\"Data.additionalDetails.lng\"]}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.syncedTime",
        "requestQueryMap": "{\"userId\": \"Data.service.auditDetials.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "os-transformer-pgr-services",
        "transformData": "rawDocuments",
        "transformKey": "complaintsTransformer",
        "aggrQuery": "{\"size\":10000,\"query\":{\"bool\":{\"must\":[]}},\"_source\":[\"Data.service.serviceRequestId\",\"Data.service.serviceCode\",\"Data.service.description\",\"Data.service.applicationStatus\",\"Data.@timestamp\"]}"
      },
      {
        "module": "COMMON",
        "dateRefField": "Data.auditDetails.createdTime",
        "requestQueryMap": "{\"userId\": \"Data.auditDetails.createdBy.keyword\", \"campaignNumber\": \"Data.campaignNumber.keyword\", \"province\": \"Data.boundaryHierarchy.province.keyword\", \"district\": \"Data.boundaryHierarchy.district.keyword\"}",
        "indexName": "os-transformed-errors-index-v1",
        "transformData": "rawDocuments",
        "transformKey": "errorTransformer",
        "aggrQuery": "{\"size\":10000,\"query\":{\"bool\":{\"must\":[]}},\"_source\":[\"Data.id\",\"Data.errorCategory\",\"Data.@timestamp\"]}"
      }
    ],
    "chartType": "rawResponse",
    "transform": {
      "taskTransformer": {
        "transformationMappings": [
          {
            "id": "Data.taskId",
            "timestamp": "Data.@timestamp",
            "actionType": "'Delivery'",
            "detail": "Data.administrationStatus === 'ADMINISTRATION_SUCCESS' ? `Delivered ${Data.quantity} of ${Data.productName}` : Data.administrationStatus",
            "gps": "Data.geoPoint[1] && Data.geoPoint[0]? `${Data.geoPoint[1]}, ${Data.geoPoint[0]}` : '-'",
            "outcome": "Data.administrationStatus === 'ADMINISTRATION_SUCCESS' ? 'SUCCESS': Data.administrationStatus"
          }
        ]
      },
      "stockTransformer": {
        "transformationMappings": [
          {
            "id": "Data.id",
            "timestamp": "Data.@timestamp",
            "actionType": "'Stock'",
            "detail": "Data.eventType === 'RECEIVED' && Data.reason === 'RETURNED' ? `${Data.facilityName} Got Return Stock of ${Data.physicalCount} ${Data.productName} from ${Data.transactingFacilityName}` : Data.eventType === 'RECEIVED' ? `${Data.facilityName} Received ${Data.physicalCount} ${Data.productName} from ${Data.transactingFacilityName}` : `${Data.facilityName} Dispatched ${Data.physicalCount} ${Data.productName} to ${Data.transactingFacilityName}`",
            "gps": "Data.additionalDetails.lat && Data.additionalDetails.lng ? `${Data.additionalDetails.lat}, ${Data.additionalDetails.lng}` : '-'",
            "outcome": "'SUCCESS'"
          }
        ]
      },
      "complaintsTransformer": {
        "transformationMappings": [
          {
            "id": "Data.service.serviceRequestId",
            "timestamp": "Data.@timestamp",
            "actionType": "'Complaint'",
            "detail": "`Raised Complaint ${Data.service.serviceCode} which is in status ${Data.service.applicationStatus} with Description ${Data.service.description}`",
            "gps": "'-'",
            "outcome": "'COMPLAINT'"
          }
        ]
      },
      "errorTransformer": {
        "transformationMappings": [
          {
            "id": "Data.id",
            "timestamp": "Data.@timestamp",
            "actionType": "'Error Record'",
            "detail": "Data.errorCategory",
            "gps": "'-'",
            "outcome": "'FAILED'"
          }
        ]
      }
    },
    "merges": [
      {
        "mergeKey": "mergedUsersRecordTaskStockSummary",
        "baseDataset": "taskTransformer",
        "dataset": "stockTransformer",
        "baseKey": "userId",
        "joinKey": "userId",
        "joinType": "concat",
        "clearDatasets": [
          "taskTransformer",
          "stockTransformer"
        ]
      },
      {
        "mergeKey": "mergedUsersRecordSummary1",
        "baseDataset": "mergedUsersRecordTaskStockSummary",
        "dataset": "complaintsTransformer",
        "baseKey": "userId",
        "joinKey": "userId",
        "joinType": "concat",
        "clearDatasets": [
          "mergedUsersRecordTaskStockSummary",
          "complaintsTransformer"
        ]
      },
      {
        "mergeKey": "mergedUsersRecordSummary",
        "baseDataset": "mergedUsersRecordSummary1",
        "dataset": "errorTransformer",
        "baseKey": "userId",
        "joinKey": "userId",
        "joinType": "concat",
        "clearDatasets": [
          "mergedUsersRecordTaskStockSummary",
          "errorTransformer"
        ]
      }
    ],
    "isCumulative": false,
    "valueType": "number",
    "showLabel": true,
    "drillChart": "none",
    "filterKeys": [
      {
        "key": "mergedUsersRecordSummary"
      }
    ],
    "documentType": "_doc",
    "action": "",
    "aggregationPaths": [
      "mergedUsersRecordSummary"
    ],
    "insight": {},
    "_comment": " "
  }
}
